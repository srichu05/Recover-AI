# RecoverAI Environment Configuration Example

# Application Settings
DEBUG=False
APP_NAME=RecoverAI
APP_VERSION=1.0.0

# Deterministic Guardrails (Defaults)
MAX_RETRIES=2
AUTONOMOUS_ACTION_LIMIT_PAISE=5000000 # ₹50,000.00
MIN_AUTONOMOUS_CONFIDENCE=0.80

# Anomaly Detection Thresholds
DEGRADATION_THRESHOLD_PCT=15.0
Z_SCORE_THRESHOLD=2.5

# Reproducibility Seed
DEFAULT_RANDOM_SEED=42

# GroqCloud LLM Configuration (OpenAI SDK Compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
USE_MOCK_LLM_IF_UNAVAILABLE=True
